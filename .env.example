# ---------------------------------------------------------------------------
# Clerk (Authentication)  ->  https://dashboard.clerk.com
# ---------------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx

# Where Clerk sends users for auth. Keep these in sync with the app routes.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/portal
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/portal

# ---------------------------------------------------------------------------
# Supabase (Database + private document storage)  ->  https://supabase.com
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Service-role key. Server-side ONLY. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Name of the private Storage bucket that holds client documents.
SUPABASE_DOCUMENTS_BUCKET=documents

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# Comma-separated list of emails that are automatically granted the accountant
# (admin) role and auto-approved on first sign-in. Seed your own email here.
ADMIN_EMAILS=you@example.com

# Public firm details shown in the UI.
NEXT_PUBLIC_FIRM_NAME=VOM HAU – Treuhand GmbH
